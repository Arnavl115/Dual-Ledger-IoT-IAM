# Copy these values into the repository-root .env on the production host.
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://iot.example.com
PUBLIC_HOSTNAME=iot.example.com
SEED_DEMO_DEVICES=false

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
ACCESS_LOG_RETENTION_DAYS=90

FABRIC_ENABLED=false
IOTA_ENABLED=false
GATEWAY_DATA_HOST_PATH=../runtime
SIMULATOR_KEY_FILE=./runtime/ecdsa_keys.json
GATEWAY_UID=1000
GATEWAY_GID=1000
# If Fabric is enabled, set container paths and the host bind source.
FABRIC_CRYPTO_HOST_PATH=../fabric-samples/test-network/organizations
CRYPTO_PATH=/fabric/organizations/peerOrganizations/org1.example.com
PEER_ENDPOINT=peer0.org1.example.com:7051

# Required by backup/restore scripts, but not consumed by the gateway.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
