# ==========================================
# FRONTEND ENVIRONMENT (frontend/ directory)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# Vite only exposes variables prefixed with VITE_.
# ==========================================

# Supabase project URL (public / safe to embed)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase ANON (public) key - used client-side for Auth.
# This is NOT a secret; RLS policies enforce row-level access.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend gateway base URL (used for all API calls)
VITE_GATEWAY_URL=http://localhost:3000
