# ==========================================
# BACKEND ENVIRONMENT (root directory)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
# Set SEED_DEMO_DEVICES=true only for local demo (never in production — devices must be registered with real PEM keys)
SEED_DEMO_DEVICES=false
NODE_ENV=development

# ------------------------------------------------------------------
# Hyperledger Fabric (leave FABRIC_ENABLED=false until network is up)
# ------------------------------------------------------------------
FABRIC_ENABLED=false
CHANNEL_NAME=mychannel
CHAINCODE_NAME=deviceregistry
MSP_ID=Org1MSP
FABRIC_IDENTITY=Admin@org1.example.com
CRYPTO_PATH=./fabric-samples/test-network/organizations/peerOrganizations/org1.example.com
PEER_ENDPOINT=localhost:7051
PEER_HOST_ALIAS=peer0.org1.example.com

# ------------------------------------------------------------------
# Supabase (PostgreSQL persistence + Auth token verification)
# ------------------------------------------------------------------
# Project URL:  Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVICE ROLE key (server-side only, NEVER expose to the frontend).
# Grants full database access; keep it strictly on the backend.
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT secret used to verify user access tokens from the frontend.
# Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Simulator authentication (admin USER credentials, never the service-role key).
# Either set a short-lived SIMULATOR_ACCESS_TOKEN, or fill all three login values.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SIMULATOR_ACCESS_TOKEN=
SIMULATOR_EMAIL=
SIMULATOR_PASSWORD=

# ------------------------------------------------------------------
# IOTA Tangle (Notarization toolkit, testnet)
# Set IOTA_ENABLED=true to route devices through the IOTA Tangle.
# Requires IOTA_NOTARIZATION_PKG_ID (publish the Notarization Move
# package first, see README "IOTA" section).
# ------------------------------------------------------------------
IOTA_ENABLED=false
IOTA_NODE_URL=https://api.testnet.iota.cafe
IOTA_FAUCET_URL=https://faucet.testnet.iota.cafe
# Package ID of the published Notarization Move package on testnet.
IOTA_NOTARIZATION_PKG_ID=0xYOUR_PUBLISHED_PACKAGE_ID
# Optional Ed25519 private key (IOTA bech32 string, e.g.
# iotaprivkey1qp2xatmfvvyeg9q...). If empty, a keypair is generated
# and persisted to .iota-key.json so the signer stays stable.
IOTA_PRIVATE_KEY=
